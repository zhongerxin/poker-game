    {
      "id": 11778485,
      "short_id": "KTNkqt9L",
      "name": "03｜每日每用户局数",
      "query": {
        "full": true,
        "kind": "DataTableNode",
        "source": {
          "kind": "HogQLQuery",
          "query": "SELECT toDate(toTimeZone(timestamp, 'Asia/Shanghai')) AS `日期`, distinct_id AS `匿名用户`, uniqExactIf(properties.hand_id, event = 'poker_hand_started') AS `开局手数`, uniqExactIf(properties.hand_id, event = 'poker_hand_completed') AS `完成手数`, uniqExactIf(properties.hand_id, event = 'poker_hand_completed' AND properties.winner = 'hero') AS `获胜手数` FROM events WHERE timestamp >= now() - INTERVAL 30 DAY AND properties.event_source = 'poker_server' AND properties.identity_source = 'openai_subject' AND properties.table_id != 'bd7194db-64bd-4501-aac1-c0226605face' AND event IN ('poker_hand_started','poker_hand_completed') GROUP BY `日期`, `匿名用户` ORDER BY `日期` DESC, `开局手数` DESC LIMIT 500"
        },
        "showExport": true
      },
      "validationQuery": "01a08c3c18b4701abc1695f50de7fb3e"
    },
    {
      "id": 11778486,
      "short_id": "b1UqaXUB",
      "name": "10｜逐手牌结果与中断明细",
      "query": {
        "full": true,
        "kind": "DataTableNode",
        "source": {
          "kind": "HogQLQuery",
          "query": "SELECT properties.hand_id AS `手牌ID`, distinct_id AS `匿名用户`, min(timestamp) AS `首次记录时间`, max(properties.chip_stack) AS `筹码档位`, groupUniqArrayIf(properties.stage, event = 'poker_stage_reached') AS `到达阶段`, maxIf(properties.winner, event = 'poker_hand_completed') AS `赢家`, maxIf(properties.end_reason, event = 'poker_hand_completed') AS `结束方式`, maxIf(properties.final_stage, event = 'poker_hand_completed') AS `结束前阶段`, uniqExactIf(uuid, event = 'poker_hand_interrupted') AS `疑似中断次数`, uniqExactIf(uuid, event = 'poker_hand_resumed') AS `恢复次数` FROM events WHERE timestamp >= now() - INTERVAL 30 DAY AND properties.event_source = 'poker_server' AND properties.identity_source = 'openai_subject' AND properties.table_id != 'bd7194db-64bd-4501-aac1-c0226605face' AND properties.hand_id IS NOT NULL AND properties.hand_id != 'setup' GROUP BY `手牌ID`, `匿名用户` ORDER BY `首次记录时间` DESC LIMIT 500"
        },
        "showExport": true
      },
      "validationQuery": "01a08c3c1b6871aba6ce8ee056690ff8"
    },
    {
      "id": 11778487,
      "short_id": "RLJqhAEV",
      "name": "11｜每日人均开局数",
      "query": {
        "full": true,
        "kind": "DataTableNode",
        "source": {
          "kind": "HogQLQuery",
          "query": "SELECT toDate(toTimeZone(timestamp, 'Asia/Shanghai')) AS `日期`, uniqExact(properties.hand_id) AS `开局手数`, uniqExact(distinct_id) AS `开局玩家数`, round(uniqExact(properties.hand_id) / nullIf(uniqExact(distinct_id), 0), 2) AS `人均开局数` FROM events WHERE timestamp >= now() - INTERVAL 30 DAY AND properties.event_source = 'poker_server' AND properties.identity_source = 'openai_subject' AND properties.table_id != 'bd7194db-64bd-4501-aac1-c0226605face' AND event = 'poker_hand_started' GROUP BY `日期` ORDER BY `日期` DESC LIMIT 30"
        },
        "showExport": true
      },
      "validationQuery": "01a08c3c1e4e7a1bba1fece8c02015d5"
    }
  ]
}
